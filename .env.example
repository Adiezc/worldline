# Copy to .env (Bun loads it automatically). Without a key the server uses an offline mock AI.
OPENROUTER_API_KEY=
# Optional local cap on AI requests per day. Unset = only OpenRouter's own limits apply
# (free models: 50/day, or 1000/day once you have bought $10 of credits).
# OPENROUTER_DAILY_LIMIT=1000
# WORLDLINE_AI=mock      # force the offline mock even when a key is set
# PORT=3001
# WORLDLINE_DB=apps/server/data/worldline.sqlite
