# Copy to .env (Bun loads it automatically). Without any AI key the server uses an offline mock AI.
OPENROUTER_API_KEY=
# Optional local cap on AI requests per day. Unset = only OpenRouter's own limits apply
# (free models: 50/day, or 1000/day once you have bought $10 of credits).
# OPENROUTER_DAILY_LIMIT=1000

# Direct providers (optional). A game's model chain reaches them with a prefix, e.g.
# "anthropic:claude-opus-5-5", "openai:<model>", "gemini:<model>", "local:<model>".
# Plain ids go to OpenRouter. The *_MODEL values are used when no model in a game's chain has a key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Any OpenAI-compatible server: Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), ...
# LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=
# LOCAL_LLM_KEY=

# WORLDLINE_AI=mock      # force the offline mock even when a key is set
# PORT=3001
# WORLDLINE_DB=apps/server/data/worldline.sqlite
