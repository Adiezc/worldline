{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/server",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "server-mock",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/server",
        "dev"
      ],
      "env": {
        "WORLDLINE_AI": "mock"
      },
      "port": 3001
    },
    {
      "name": "test-server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/server",
        "src/index.ts"
      ],
      "env": {
        "WORLDLINE_AI": "mock",
        "PORT": "3002",
        "WORLDLINE_DB": "data/test.sqlite"
      },
      "port": 3002
    },
    {
      "name": "test-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/web",
        "dev"
      ],
      "env": {
        "WORLDLINE_SERVER": "localhost:3002",
        "WEB_PORT": "5174"
      },
      "port": 5174
    }
  ]
}
