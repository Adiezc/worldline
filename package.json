{
  "name": "worldline",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "mapgen": "bun run --cwd tools/mapgen build",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "server": "bun --cwd apps/server dev",
    "ai:smoke": "bun --cwd apps/server ai:smoke"
  }
}
